{
  // Config for deploying this app as a Cloudflare Workers static-assets site
  // via the Wrangler CLI (npx wrangler deploy), as an alternative to the
  // drag-and-drop Cloudflare Pages / Netlify Drop / GitHub Pages options in README.md.
  "name": "english",
  "compatibility_date": "2024-09-23",
  "assets": {
    // Serve everything in this folder (index.html, manifest.json, sw.js, icons/) as static files.
    "directory": "./public",
    // Any unmatched path falls back to index.html — safe here since the whole app
    // is a single page with client-side tab switching, not real multi-page routes.
    "not_found_handling": "single-page-application"
  }
}
